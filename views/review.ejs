<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <title>Form Ulasan Aman</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-6">
  <main class="max-w-xl mx-auto bg-white p-6 rounded-lg shadow">
    <h1 class="text-xl font-bold mb-4">Ulasan Produk</h1>

    <% if (errors.length > 0) { %>
      <div class="bg-red-100 text-red-700 p-3 rounded mb-4 text-sm">
        <% errors.forEach(e => { %><p>• <%= e %></p><% }) %>
      </div>
    <% } %>

    <% if (beforeAfter) { %>
      <div class="bg-blue-50 p-3 rounded mb-4 text-xs font-mono">
        <p>Before: <%= beforeAfter.before %></p>
        <p>After: <%= beforeAfter.after %></p>
      </div>
    <% } %>

    <form action="/review" method="POST" class="space-y-3 mb-6">
      <input type="number" name="rating" placeholder="Rating (1-5)" class="w-full border p-2 rounded text-sm">
      <textarea name="comment" placeholder="Komentar ulasan..." class="w-full border p-2 rounded text-sm"></textarea>
      <button class="bg-blue-600 text-white px-4 py-2 rounded text-sm font-semibold">Kirim</button>
    </form>

    <h2 class="font-bold mb-2">Daftar Ulasan</h2>
    <% reviews.forEach(r => { %>
      <div class="border-b py-2 text-sm">
        <span class="font-bold"><%= r.username %> (<%= r.rating %>/5):</span>
        <!-- Di-escape dengan <%= %> -->
        <p><%= r.comment %></p>
      </div>
    <% }) %>
  </main>
</body>
</html>